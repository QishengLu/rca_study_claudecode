# Copy to `.env` and fill in ANTHROPIC_API_KEY only.
# ClaudeCode drives the `claude` CLI (must be on PATH) against a qwen ANTHROPIC-protocol endpoint:
# the Model Studio Coding Plan endpoint below with a Coding Plan key, or
# https://dashscope.aliyuncs.com/apps/anthropic with a Model Studio (DashScope) key.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL_OVERRIDE=https://coding.dashscope.aliyuncs.com/apps/anthropic
RCA_MODEL=qwen3.5-plus
CLAUDE_BIN=claude
